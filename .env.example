# VAJRA-AI Environment Configuration Template
# Copy this file to .env and fill in optional configuration keys.

# Optional: OpenWeather API key for radar telemetry
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Numerical Weather Prediction API URL (defaults to Open-Meteo public endpoint if unset)
NWP_API_URL=https://api.open-meteo.com/v1/forecast

# Optional: Automatic Weather Station telemetry endpoint
AWS_API_URL=

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list of origins, or * for all)
CORS_ORIGINS=*
